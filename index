<!DOCTYPE html>
<html lang="ro">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MAKU – Contact</title>
<meta name="description" content="Lasă-ne datele tale și te contactăm.">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' fill='%23DAD3C8'/><text y='72' x='50' text-anchor='middle' font-size='58' font-family='Arial' font-weight='700' fill='%23251D13'>M</text></svg>">
<style>
  :root{
    --bg:#DAD3C8;
    --ink:#251D13;
    --ink-soft:#5c5245;
    --line:#c2b9ab;
    --card:#e7e2da;
    --white:#f4f1ec;
    --err:#a8362b;
    --ok:#3f6b46;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html,body{height:100%}
  body{
    background:var(--bg);
    color:var(--ink);
    font-family:"Helvetica Neue",Helvetica,Arial,"Segoe UI",sans-serif;
    -webkit-font-smoothing:antialiased;
    display:flex;
    align-items:flex-start;
    justify-content:center;
    padding:48px 20px 64px;
  }
  .wrap{width:100%;max-width:520px}

  .logo{
    display:block;
    width:200px;
    max-width:56%;
    height:auto;
    margin:0 auto 34px;
  }

  .card{
    background:var(--card);
    border:1px solid var(--line);
    border-radius:14px;
    padding:32px 28px;
  }
  @media (max-width:480px){ .card{padding:24px 18px} body{padding-top:32px} }

  h1{
    font-size:20px;
    font-weight:700;
    letter-spacing:-.01em;
    margin-bottom:6px;
  }
  .sub{font-size:14px;color:var(--ink-soft);margin-bottom:26px;line-height:1.5}

  .field{margin-bottom:18px}
  .row{display:flex;gap:14px}
  .row .field{flex:1;min-width:0}
  @media (max-width:480px){ .row{display:block} }

  label{
    display:block;
    font-size:12.5px;
    font-weight:600;
    letter-spacing:.02em;
    text-transform:uppercase;
    margin-bottom:7px;
    color:var(--ink);
  }
  label .opt{
    text-transform:none;
    font-weight:400;
    letter-spacing:0;
    color:var(--ink-soft);
    font-size:12px;
  }

  input,textarea{
    width:100%;
    font-family:inherit;
    font-size:15px;
    color:var(--ink);
    background:var(--white);
    border:1px solid var(--line);
    border-radius:9px;
    padding:12px 13px;
    transition:border-color .15s, box-shadow .15s;
  }
  textarea{min-height:110px;resize:vertical;line-height:1.5}
  input::placeholder,textarea::placeholder{color:#9c9284}
  input:focus,textarea:focus{
    outline:none;
    border-color:var(--ink);
    box-shadow:0 0 0 3px rgba(37,29,19,.10);
  }
  input.invalid,textarea.invalid{border-color:var(--err);box-shadow:0 0 0 3px rgba(168,54,43,.10)}

  .err{
    display:none;
    font-size:12.5px;
    color:var(--err);
    margin-top:6px;
  }
  .err.show{display:block}

  button{
    width:100%;
    margin-top:8px;
    font-family:inherit;
    font-size:15px;
    font-weight:700;
    letter-spacing:.02em;
    color:var(--bg);
    background:var(--ink);
    border:0;
    border-radius:9px;
    padding:14px 16px;
    cursor:pointer;
    transition:opacity .15s, transform .05s;
  }
  button:hover{opacity:.88}
  button:active{transform:translateY(1px)}
  button[disabled]{opacity:.55;cursor:not-allowed}

  .note{
    font-size:12px;
    color:var(--ink-soft);
    text-align:center;
    margin-top:16px;
    line-height:1.5;
  }

  .hp{position:absolute;left:-9999px;width:1px;height:1px;opacity:0}

  /* success */
  .success{display:none;text-align:center;padding:14px 4px}
  .success.show{display:block}
  .check{
    width:56px;height:56px;border-radius:50%;
    background:var(--ink);
    display:flex;align-items:center;justify-content:center;
    margin:0 auto 18px;
  }
  .check svg{width:26px;height:26px;stroke:var(--bg);stroke-width:2.6;fill:none;stroke-linecap:round;stroke-linejoin:round}
  .success h2{font-size:19px;margin-bottom:8px}
  .success p{font-size:14px;color:var(--ink-soft);line-height:1.6}
  .again{
    display:inline-block;margin-top:20px;font-size:13.5px;font-weight:600;
    color:var(--ink);text-decoration:underline;cursor:pointer;background:none;border:0;width:auto;padding:0;
  }
  .again:hover{opacity:.7}

  .formhide{display:none}
  footer{text-align:center;font-size:11.5px;color:var(--ink-soft);margin-top:28px;letter-spacing:.03em}
</style>
</head>
<body>
<div class="wrap">

  <img class="logo" src="logo.png" alt="MAKU">

  <div class="card">

    <div id="formArea">
      <h1>Lasă-ne datele tale</h1>
      <p class="sub">Completează formularul și te contactăm în cel mai scurt timp.</p>

      <form id="leadForm" novalidate>
        <div class="row">
          <div class="field">
            <label for="nume">Nume</label>
            <input type="text" id="nume" name="nume" autocomplete="family-name" placeholder="Popescu" required>
            <div class="err" id="err-nume">Completează numele.</div>
          </div>
          <div class="field">
            <label for="prenume">Prenume</label>
            <input type="text" id="prenume" name="prenume" autocomplete="given-name" placeholder="Ion" required>
            <div class="err" id="err-prenume">Completează prenumele.</div>
          </div>
        </div>

        <div class="field">
          <label for="telefon">Număr de telefon</label>
          <input type="tel" id="telefon" name="telefon" autocomplete="tel" inputmode="tel" placeholder="07XX XXX XXX" required>
          <div class="err" id="err-telefon">Introdu un număr de telefon valid.</div>
        </div>

        <div class="field">
          <label for="companie">Numele companiei <span class="opt">(opțional)</span></label>
          <input type="text" id="companie" name="companie" autocomplete="organization" placeholder="SRL / PFA / firmă">
        </div>

        <div class="field">
          <label for="mentiuni">Mențiuni <span class="opt">(opțional)</span></label>
          <textarea id="mentiuni" name="mentiuni" placeholder="Scrie aici ce te interesează, cantități, termene, detalii..."></textarea>
        </div>

        <input class="hp" type="text" name="website" id="website" tabindex="-1" autocomplete="off" aria-hidden="true">

        <button type="submit" id="submitBtn">Trimite</button>
        <p class="note" id="note">Datele tale sunt folosite doar pentru a te contacta.</p>
      </form>
    </div>

    <div class="success" id="success">
      <div class="check">
        <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
      </div>
      <h2>Mulțumim!</h2>
      <p>Am primit datele tale. Te contactăm în curând.</p>
      <button class="again" id="again" type="button">Trimite alt formular</button>
    </div>

  </div>

</div>

<script>
/* =========================================================
   1. Lipește aici URL-ul Web App din Google Apps Script
      (arata asa: https://script.google.com/macros/s/AKfy.../exec)
   ========================================================= */
const ENDPOINT = "https://script.google.com/macros/s/AKfycb..../exec";
const form      = document.getElementById('leadForm');
const btn       = document.getElementById('submitBtn');
const note      = document.getElementById('note');
const formArea  = document.getElementById('formArea');
const success   = document.getElementById('success');

function setErr(id, show, msg){
  const input = document.getElementById(id);
  const err   = document.getElementById('err-' + id);
  input.classList.toggle('invalid', show);
  if (err){ if (msg) err.textContent = msg; err.classList.toggle('show', show); }
}

function validPhone(v){
  const digits = v.replace(/[^\d]/g, '');
  return digits.length >= 8 && digits.length <= 15;
}

['nume','prenume','telefon'].forEach(id => {
  document.getElementById(id).addEventListener('input', () => setErr(id, false));
});

form.addEventListener('submit', function(e){
  e.preventDefault();

  const nume     = document.getElementById('nume').value.trim();
  const prenume  = document.getElementById('prenume').value.trim();
  const telefon  = document.getElementById('telefon').value.trim();
  const companie = document.getElementById('companie').value.trim();
  const mentiuni = document.getElementById('mentiuni').value.trim();
  const hp       = document.getElementById('website').value;

  let ok = true;
  if (!nume)                { setErr('nume', true);    ok = false; }
  if (!prenume)             { setErr('prenume', true); ok = false; }
  if (!telefon)             { setErr('telefon', true, 'Completează numărul de telefon.'); ok = false; }
  else if (!validPhone(telefon)) { setErr('telefon', true, 'Introdu un număr de telefon valid.'); ok = false; }
  if (!ok) return;

  if (hp) { showSuccess(); return; } /* bot */

  btn.disabled = true;
  btn.textContent = 'Se trimite...';
  note.textContent = '';

  const params = new URLSearchParams({
    nume: nume,
    prenume: prenume,
    telefon: telefon,
    companie: companie,
    mentiuni: mentiuni,
    sursa: location.href,
    user_agent: navigator.userAgent
  });

  fetch(ENDPOINT, {
    method: 'POST',
    mode: 'no-cors',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8' },
    body: params.toString()
  })
  .then(showSuccess)
  .catch(function(){
    btn.disabled = false;
    btn.textContent = 'Trimite';
    note.textContent = 'Nu am putut trimite datele. Verifică conexiunea și încearcă din nou.';
    note.style.color = '#a8362b';
  });
});

function showSuccess(){
  formArea.classList.add('formhide');
  success.classList.add('show');
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

document.getElementById('again').addEventListener('click', function(){
  form.reset();
  btn.disabled = false;
  btn.textContent = 'Trimite';
  note.textContent = 'Datele tale sunt folosite doar pentru a te contacta.';
  note.style.color = '';
  success.classList.remove('show');
  formArea.classList.remove('formhide');
});
</script>
</body>
</html>
